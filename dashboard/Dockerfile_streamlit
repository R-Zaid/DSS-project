# Use an official Python runtime as a parent image
FROM python:3.8

# Set the working directory to /app
WORKDIR /app

# Copy requirements and install script
COPY ./dashboard/requirements.txt /app/requirements.txt

# Install OS-level dependencies and configure pip
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       gcc \
       gdal-bin \
       libgdal-dev \
       proj-bin \
       libproj-dev \
       libgeos-dev \
       libspatialindex-dev \
       libsqlite3-dev \
       libxml2-dev \
       libpq-dev \
       ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --upgrade pip \
    && pip install setuptools wheel

# Copy the rest of the dashboard code
COPY ./dashboard /app

# Streamlit default port is 8501; expose that and match docker-compose
EXPOSE 8501

# Define the streamlit app file (kept for clarity)
ENV STREAMLIT_APP=dashboard.py

# Install packages with retries
RUN for i in 1 2 3 4 5; do \
        pip install --no-cache-dir -r requirements.txt && break || sleep 15; \
    done

# Copy and setup the startup script
COPY ./dashboard/start.sh /app/start.sh
RUN chmod +x /app/start.sh

# Copy the data loading script
COPY ./scripts/load_yearly_averages.py /app/load_yearly_averages.py

# Use the startup script as the entry point
CMD ["/app/start.sh"]
